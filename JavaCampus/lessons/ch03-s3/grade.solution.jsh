// 段考筆記：等第（從高分往低分問）
if (score >= 90) {
    System.out.println(score + " 分是 A");
} else if (score >= 80) {
    System.out.println(score + " 分是 B");
} else if (score >= 70) {
    System.out.println(score + " 分是 C");
} else if (score >= 60) {
    System.out.println(score + " 分是 D");
} else {
    System.out.println(score + " 分是 F");
}
